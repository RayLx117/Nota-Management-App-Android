<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:layout_marginTop="2dp" android:layout_marginBottom="2dp"
    android:background="@drawable/widget_chip" android:paddingStart="10dp" android:paddingEnd="10dp"
    android:paddingTop="8dp" android:paddingBottom="8dp">
    <ImageView android:id="@+id/bar" android:layout_width="4dp" android:layout_height="18dp"
        android:src="@drawable/widget_chip_mint" android:scaleType="fitXY" android:contentDescription="@null" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:paddingStart="10dp">
        <TextView android:id="@+id/text" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFEEF2FA" android:textSize="14sp" android:maxLines="1" android:ellipsize="end"
            android:fontFamily="@font/outfit_semibold" />
        <TextView android:id="@+id/notes" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FF8E9AB8" android:textSize="11sp" android:maxLines="2" android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
