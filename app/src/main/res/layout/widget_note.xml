<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg"
    android:paddingStart="14dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="10dp">

    <!-- Top banner: opens a new note in the full app. -->
    <LinearLayout android:id="@+id/banner" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="2dp" android:paddingBottom="6dp">
        <ImageView android:id="@+id/icon" android:layout_width="16dp" android:layout_height="16dp"
            android:src="@drawable/ic_tab_notes" android:contentDescription="@null" />
        <TextView android:id="@+id/label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="QUICK NOTE" android:textColor="#FF8E9AB8" android:textSize="10sp" android:letterSpacing="0.15"
            android:fontFamily="@font/outfit_semibold" android:paddingStart="8dp" />
        <TextView android:id="@+id/full" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Full note" android:textColor="#FF2EE59D" android:textSize="12sp" android:fontFamily="@font/outfit_semibold" />
        <ImageView android:id="@+id/full_arrow" android:layout_width="16dp" android:layout_height="16dp"
            android:src="@drawable/widget_next" android:contentDescription="@null" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/field" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:minHeight="52dp" android:background="@drawable/widget_chip" android:gravity="center_vertical"
            android:paddingStart="14dp" android:paddingEnd="14dp" android:text="Write a note…"
            android:textColor="#FF8E9AB8" android:textSize="15sp" android:fontFamily="@font/outfit_semibold" />
        <ImageView android:id="@+id/save" android:layout_width="60dp" android:layout_height="60dp"
            android:layout_marginStart="10dp" android:padding="15dp" android:src="@drawable/ic_check"
            android:background="@drawable/widget_circle" android:contentDescription="Save note" />
    </LinearLayout>
</LinearLayout>
