<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg"
    android:paddingStart="14dp" android:paddingEnd="12dp" android:paddingTop="10dp" android:paddingBottom="10dp">

    <!-- Across the top: a new note in the full app. -->
    <TextView android:id="@+id/banner" android:layout_width="match_parent" android:layout_height="34dp"
        android:layout_marginBottom="8dp" android:background="@drawable/widget_pill" android:gravity="center"
        android:text="Open note in app" android:textColor="#FF2EE59D" android:textSize="13sp"
        android:fontFamily="@font/outfit_semibold" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/field" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:minHeight="52dp" android:background="@drawable/widget_chip" android:gravity="center_vertical"
            android:paddingStart="14dp" android:paddingEnd="14dp" android:text="Write a note…"
            android:textColor="#FF8E9AB8" android:textSize="15sp" android:fontFamily="@font/outfit_semibold" />
        <ImageView android:id="@+id/save" android:layout_width="60dp" android:layout_height="60dp"
            android:layout_marginStart="10dp" android:padding="15dp" android:src="@drawable/ic_check"
            android:background="@drawable/widget_circle" android:contentDescription="Save note" />
    </LinearLayout>
</LinearLayout>
