<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg"
    android:paddingStart="14dp" android:paddingEnd="12dp" android:paddingTop="10dp" android:paddingBottom="10dp">

    <!-- Across the top: a new note in the full app. -->
    <TextView android:id="@+id/banner" android:layout_width="match_parent" android:layout_height="34dp"
        android:layout_marginBottom="8dp" android:background="@drawable/widget_pill" android:gravity="center"
        android:text="Open note in app" android:textColor="#FF2EE59D" android:textSize="13sp"
        android:fontFamily="@font/outfit_semibold" />

    <!-- A "Write a note" button: typing happens in the popup. -->
    <FrameLayout android:id="@+id/write_area" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout android:id="@+id/write" android:layout_width="wrap_content" android:layout_height="52dp"
            android:layout_gravity="center" android:orientation="horizontal" android:gravity="center_vertical"
            android:background="@drawable/widget_pill" android:paddingStart="22dp" android:paddingEnd="26dp">
            <ImageView android:id="@+id/write_icon" android:layout_width="22dp" android:layout_height="22dp"
                android:src="@drawable/ic_edit" android:contentDescription="@null" />
            <TextView android:id="@+id/write_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingStart="10dp" android:text="Write a note" android:textColor="#FF0B1020" android:textSize="17sp"
                android:fontFamily="@font/outfit_extrabold" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
