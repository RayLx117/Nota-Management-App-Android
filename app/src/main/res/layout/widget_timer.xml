<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="12dp">
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Timer" android:textColor="#FFEEF2FA" android:textSize="16sp" android:paddingStart="4dp"
        android:fontFamily="@font/outfit_extrabold" android:maxLines="1" android:ellipsize="end" />

    <LinearLayout android:id="@+id/idle" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="8dp">
        <TextView android:id="@+id/p0" style="@style/WidgetPreset" />
        <TextView android:id="@+id/p1" style="@style/WidgetPreset" />
        <TextView android:id="@+id/p2" style="@style/WidgetPreset" />
        <TextView android:id="@+id/p3" style="@style/WidgetPreset" />
    </LinearLayout>

    <LinearLayout android:id="@+id/running" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:paddingStart="4dp">
            <Chronometer android:id="@+id/chrono" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFEEF2FA" android:textSize="30sp" android:fontFamily="@font/jetbrains_mono_semibold" />
            <TextView android:id="@+id/paused" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FF8E9AB8" android:textSize="30sp" android:fontFamily="@font/jetbrains_mono_semibold"
                android:visibility="gone" />
            <TextView android:id="@+id/label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FF8E9AB8" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/toggle" android:layout_width="wrap_content" android:layout_height="40dp"
            android:background="@drawable/widget_chip_mint" android:gravity="center" android:paddingStart="14dp"
            android:paddingEnd="14dp" android:textColor="#FF06121A" android:textSize="14sp"
            android:fontFamily="@font/outfit_extrabold" />
        <TextView android:id="@+id/cancel" android:layout_width="wrap_content" android:layout_height="40dp"
            android:layout_marginStart="6dp" android:background="@drawable/widget_chip" android:gravity="center"
            android:paddingStart="12dp" android:paddingEnd="12dp" android:text="✕" android:textColor="#FFFF6B6B"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
