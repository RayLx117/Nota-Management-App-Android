<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="38dp"
    android:layout_marginTop="2dp" android:layout_marginBottom="2dp"
    android:background="@drawable/widget_chip" android:paddingStart="10dp" android:paddingEnd="10dp">
    <ImageView android:id="@+id/bar" android:layout_width="4dp" android:layout_height="18dp"
        android:src="@drawable/widget_chip_mint" android:scaleType="fitXY" android:contentDescription="@null" />
    <TextView android:id="@+id/time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="64dp"
        android:paddingStart="10dp" android:textSize="12sp" android:textColor="#FF8E9AB8" android:fontFamily="@font/jetbrains_mono_semibold" android:maxLines="1" />
    <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:paddingStart="8dp" android:textSize="14sp" android:textColor="#FFEEF2FA" android:fontFamily="@font/outfit_semibold"
        android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
