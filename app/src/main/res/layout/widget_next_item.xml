<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:layout_marginTop="2dp" android:layout_marginBottom="2dp"
    android:background="@drawable/widget_chip" android:paddingStart="10dp" android:paddingEnd="6dp"
    android:minHeight="44dp">
    <ImageView android:id="@+id/bar" android:layout_width="4dp" android:layout_height="20dp"
        android:src="@drawable/widget_chip_mint" android:scaleType="fitXY" android:contentDescription="@null" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:paddingStart="10dp" android:paddingTop="6dp" android:paddingBottom="6dp">
        <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFEEF2FA" android:textSize="14sp" android:maxLines="1" android:ellipsize="end"
            android:fontFamily="@font/outfit_semibold" />
        <TextView android:id="@+id/when" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FF8E9AB8" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:id="@+id/in" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#FF22C3E6" android:textSize="13sp" android:fontFamily="@font/outfit_extrabold"
        android:maxLines="1" android:paddingStart="8dp" android:paddingEnd="6dp" />
    <!-- Pinned reminders: tap to mark done and dismiss. -->
    <ImageView android:id="@+id/dismiss" android:layout_width="36dp" android:layout_height="36dp"
        android:padding="8dp" android:src="@drawable/ic_check" android:background="@drawable/widget_circle"
        android:contentDescription="Done" android:visibility="gone" />
</LinearLayout>
