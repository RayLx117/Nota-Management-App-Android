<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg"
    android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="10dp" android:paddingBottom="8dp">

    <!-- Next alarm: one slim line. -->
    <LinearLayout android:id="@+id/alarm" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="8dp">
        <ImageView android:id="@+id/alarm_icon" android:layout_width="16dp" android:layout_height="16dp"
            android:src="@drawable/ic_tab_alarm" android:contentDescription="@null" />
        <TextView android:id="@+id/alarm_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFEEF2FA" android:textSize="16sp" android:fontFamily="@font/jetbrains_mono_semibold"
            android:maxLines="1" android:paddingStart="8dp" android:text="7:00 AM" />
        <TextView android:id="@+id/alarm_title" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textColor="#FF8E9AB8" android:textSize="12sp" android:maxLines="1"
            android:ellipsize="end" android:paddingStart="8dp" />
        <TextView android:id="@+id/alarm_in" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FF2EE59D" android:textSize="13sp" android:fontFamily="@font/outfit_extrabold"
            android:maxLines="1" android:paddingStart="8dp" android:text="in 8 h" />
    </LinearLayout>

    <ImageView android:id="@+id/divider" android:layout_width="match_parent" android:layout_height="1dp"
        android:src="@drawable/widget_chip" android:scaleType="fitXY" android:contentDescription="@null" />

    <TextView android:id="@+id/reminder_label" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="REMINDERS" android:textColor="#FF8E9AB8" android:textSize="9sp" android:letterSpacing="0.15"
        android:fontFamily="@font/outfit_semibold" android:paddingTop="8dp" android:paddingBottom="4dp" />

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/items" android:layout_width="match_parent" android:layout_height="match_parent"
            android:divider="@null" android:dividerHeight="0dp" android:scrollbars="none" />
        <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:textColor="#FF8E9AB8" android:textSize="13sp" android:text="Nothing coming up" />
    </FrameLayout>
</LinearLayout>
